{
  "openapi": "3.1.0",
  "info": {
    "title": "IW3 - Ordenes de carga de gas licuado",
    "description": "APIs de integracion con SAP, TMS (balanza) y el sistema de carga.\n\nCiclo de una orden: 1 Pendiente de pesaje inicial -> 2 Con pesaje inicial registrado\n-> 3 Cerrada para carga -> 4 Finalizada. Los estados no pueden retroceder.\n\nSeguridad: primero hacer POST /api/v1/auth/login y usar el token con el boton Authorize.\nRoles: SAP (alta de orden), TMS (pesajes), SISTEMA_CARGA (habilitar, detalle y cierre),\nOPERADOR (consultas y alarmas) y ADMIN (todo).\n\nErrores: 400 datos invalidos, 401 sin token o password incorrecta, 403 rol sin permiso,\n404 orden inexistente, 409 la operacion no corresponde al estado actual de la orden\n(o numero de orden duplicado).",
    "version": "v1"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Generated server url"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "5. Monitoreo",
      "description": "Seguimiento de las ordenes en tiempo real"
    },
    {
      "name": "4. Consultas",
      "description": "Consulta de ordenes, auditoria, detalle y conciliacion"
    },
    {
      "name": "6. Alarmas",
      "description": "Alarmas de temperatura: listado y aceptacion"
    },
    {
      "name": "3. Sistema de carga",
      "description": "Habilitacion, datos en tiempo real y cierre de la carga"
    },
    {
      "name": "0. Autenticacion",
      "description": "Login: devuelve el token JWT para usar en el resto de las APIs"
    },
    {
      "name": "1. SAP",
      "description": "Recepcion de ordenes desde el sistema externo"
    },
    {
      "name": "2. TMS (balanza)",
      "description": "Pesaje inicial (tara) y pesaje final"
    }
  ],
  "paths": {
    "/api/v1/ordenes": {
      "get": {
        "tags": [
          "4. Consultas"
        ],
        "summary": "Listar ordenes",
        "description": "Opcionalmente filtradas por estado.",
        "operationId": "listar",
        "parameters": [
          {
            "name": "estado",
            "in": "query",
            "description": "Filtro opcional por estado",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "PENDIENTE_PESAJE_INICIAL",
                "CON_PESAJE_INICIAL",
                "CERRADA_PARA_CARGA",
                "FINALIZADA"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrdenResponse"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "1. SAP"
        ],
        "summary": "Punto 1 - Recibir orden desde SAP",
        "description": "Sincroniza camion, chofer, cliente y producto por codigo externo (los crea o actualiza) y crea la orden en estado 1: Pendiente de pesaje inicial.",
        "operationId": "crear",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrdenSapRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Orden creada",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OrdenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Datos invalidos",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Ya existe una orden con ese numero",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ordenes/{numeroOrden}/pesaje-inicial": {
      "post": {
        "tags": [
          "2. TMS (balanza)"
        ],
        "summary": "Punto 2 - Registrar pesaje inicial (tara)",
        "description": "Registra el peso del camion vacio, genera la contrasena de activacion de 5 digitos y pasa la orden a estado 2. Solo para ordenes en estado 1.",
        "operationId": "pesajeInicial",
        "parameters": [
          {
            "name": "numeroOrden",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PesajeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Pesaje registrado; incluye la contrasena de activacion",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/PesajeInicialResponse"
                }
              }
            }
          },
          "400": {
            "description": "Datos invalidos",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "La orden no existe",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "La orden no esta en estado 1",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ordenes/{numeroOrden}/pesaje-final": {
      "post": {
        "tags": [
          "2. TMS (balanza)"
        ],
        "summary": "Punto 5 - Registrar pesaje final y obtener la conciliacion",
        "description": "Registra el peso del camion cargado, pasa la orden a estado 4: Finalizada y devuelve la conciliacion. Solo para ordenes en estado 3.",
        "operationId": "pesajeFinal",
        "parameters": [
          {
            "name": "numeroOrden",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PesajeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Pesaje registrado; se devuelve la conciliacion",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ConciliacionResponse"
                }
              }
            }
          },
          "400": {
            "description": "Datos invalidos",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "La orden no existe",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "La orden no esta en estado 3",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ordenes/{numeroOrden}/habilitar-carga": {
      "post": {
        "tags": [
          "3. Sistema de carga"
        ],
        "summary": "Punto 3.1 - Habilitar carga (password -> preset)",
        "description": "Valida que la orden exista, este en estado 2 y la contrasena sea correcta. Devuelve el preset para iniciar la carga. No cambia el estado.",
        "operationId": "habilitarCarga",
        "parameters": [
          {
            "name": "numeroOrden",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/HabilitacionCargaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Contrasena correcta; se devuelve el preset",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/HabilitacionCargaResponse"
                }
              }
            }
          },
          "400": {
            "description": "Datos invalidos",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Contrasena incorrecta",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "La orden no existe",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "La orden no esta en estado 2",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ordenes/{numeroOrden}/detalle": {
      "get": {
        "tags": [
          "4. Consultas"
        ],
        "summary": "Detalle de carga almacenado",
        "description": "Registros historicos guardados segun la frecuencia configurada.",
        "operationId": "detalle",
        "parameters": [
          {
            "name": "numeroOrden",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/DetalleCargaResponse"
                  }
                }
              }
            }
          },
          "404": {
            "description": "La orden no existe",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "3. Sistema de carga"
        ],
        "summary": "Punto 3.3 - Recibir dato de carga en tiempo real",
        "description": "Se descarta (aceptado=false) si caudal <= 0, masa <= 0, masa menor a la anterior o densidad fuera de (0, 1]. Si es valido actualiza la cabecera de la orden y, segun la frecuencia configurada, se guarda como detalle. Solo para ordenes en estado 2.",
        "operationId": "detalle_1",
        "parameters": [
          {
            "name": "numeroOrden",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DetalleCargaRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Dato procesado (ver aceptado / almacenado / motivoDescarte)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/DetalleCargaResultado"
                }
              }
            }
          },
          "400": {
            "description": "Faltan valores o tienen formato invalido",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "La orden no existe",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "La orden no esta en estado 2 (por ejemplo, ya fue cerrada)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ordenes/{numeroOrden}/cierre": {
      "post": {
        "tags": [
          "3. Sistema de carga"
        ],
        "summary": "Punto 4 - Cerrar la orden",
        "description": "Pasa la orden a estado 3: Cerrada para carga. A partir de aca se rechazan nuevos datos de detalle. El body es opcional (observaciones para la auditoria). Solo para ordenes en estado 2.",
        "operationId": "cerrar",
        "parameters": [
          {
            "name": "numeroOrden",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CierreRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Orden cerrada",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OrdenResponse"
                }
              }
            }
          },
          "404": {
            "description": "La orden no existe",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "La orden no esta en estado 2",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "0. Autenticacion"
        ],
        "summary": "Login",
        "description": "Con usuario y contrasena devuelve un token. Enviarlo en cada request como 'Authorization: Bearer <token>'.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            }
          },
          "400": {
            "description": "Faltan datos",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Usuario o contrasena incorrectos",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/alarmas/{id}/aceptar": {
      "post": {
        "tags": [
          "6. Alarmas"
        ],
        "summary": "Aceptar una alarma",
        "description": "Registra el usuario autenticado, la fecha/hora y la observacion. Solo roles OPERADOR y ADMIN. Despues de aceptarla, un nuevo dato sobre el umbral vuelve a generar alarma y mail.",
        "operationId": "aceptar",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AceptarAlarmaRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/AlarmaResponse"
                }
              }
            }
          },
          "403": {
            "description": "El rol no puede aceptar alarmas",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "La alarma no existe",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "La alarma ya estaba aceptada",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ordenes/{numeroOrden}": {
      "get": {
        "tags": [
          "4. Consultas"
        ],
        "summary": "Consultar una orden",
        "description": "Incluye la cabecera con los ultimos valores de carga.",
        "operationId": "buscar",
        "parameters": [
          {
            "name": "numeroOrden",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/OrdenResponse"
                }
              }
            }
          },
          "404": {
            "description": "La orden no existe",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ordenes/{numeroOrden}/historial-estados": {
      "get": {
        "tags": [
          "4. Consultas"
        ],
        "summary": "Log de auditoria de estados",
        "description": "Todos los cambios de estado de la orden, en orden cronologico.",
        "operationId": "historial",
        "parameters": [
          {
            "name": "numeroOrden",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CambioEstadoResponse"
                  }
                }
              }
            }
          },
          "404": {
            "description": "La orden no existe",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ordenes/{numeroOrden}/conciliacion": {
      "get": {
        "tags": [
          "4. Consultas"
        ],
        "summary": "Punto 5 - Consultar conciliacion",
        "description": "Solo disponible para ordenes en estado 4: Finalizada.",
        "operationId": "conciliacion",
        "parameters": [
          {
            "name": "numeroOrden",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ConciliacionResponse"
                }
              }
            }
          },
          "404": {
            "description": "La orden no existe",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "La orden todavia no esta finalizada",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/monitoreo": {
      "get": {
        "tags": [
          "5. Monitoreo"
        ],
        "summary": "Monitoreo de ordenes",
        "description": "Ultimos valores de carga de cada orden, con ETA de llenado (horas) y tiempo transcurrido desde el inicio de carga (segundos). Ambos calculos solo se informan para ordenes en estado 2. El frontend lo consulta cada pocos segundos.",
        "operationId": "monitoreo",
        "parameters": [
          {
            "name": "estado",
            "in": "query",
            "description": "Filtro por estado",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "PENDIENTE_PESAJE_INICIAL",
                "CON_PESAJE_INICIAL",
                "CERRADA_PARA_CARGA",
                "FINALIZADA"
              ]
            }
          },
          {
            "name": "patente",
            "in": "query",
            "description": "Filtro por patente (contiene el texto)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ordenarPor",
            "in": "query",
            "description": "numeroOrden, estado, patente, preset, masa, temperatura, densidad o caudal",
            "required": false,
            "schema": {
              "type": "string",
              "default": "numeroOrden"
            }
          },
          {
            "name": "direccion",
            "in": "query",
            "description": "asc o desc",
            "required": false,
            "schema": {
              "type": "string",
              "default": "asc"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MonitoreoOrdenResponse"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/alarmas": {
      "get": {
        "tags": [
          "6. Alarmas"
        ],
        "summary": "Listar alarmas",
        "description": "Las mas recientes primero. Opcionalmente filtradas por estado (PENDIENTE o ACEPTADA).",
        "operationId": "listar_1",
        "parameters": [
          {
            "name": "estado",
            "in": "query",
            "description": "Filtro opcional por estado",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "PENDIENTE",
                "ACEPTADA"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AlarmaResponse"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CamionDto": {
        "type": "object",
        "properties": {
          "codigoExterno": {
            "type": "string",
            "example": "CAM-001",
            "maxLength": 50,
            "minLength": 0
          },
