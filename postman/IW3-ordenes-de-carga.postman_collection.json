{
  "info": {
    "name": "IW3 - Ordenes de carga de gas licuado",
    "description": "Circuito completo de una orden (puntos 1 a 5) con casos de error.\n\nCorrer con el Collection Runner (o newman) en orden: cada request guarda variables (numeroOrden, password, masa) que usan los siguientes.\n\nCambiar baseUrl en las variables de la coleccion si el backend no esta en localhost:8080.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Circuito completo de una orden",
      "item": [
        {
          "name": "01 [SAP] Crear orden",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/ordenes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "ordenes"
              ]
            },
            "description": "Punto 1. SAP envia la orden; se sincronizan camion, chofer, cliente y producto por codigo externo.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroOrden\": {{numeroOrden}},\n  \"camion\": {\n    \"codigoExterno\": \"CAM-001\",\n    \"patente\": \"AB123CD\",\n    \"descripcion\": \"Scania cisterna doble\",\n    \"cisternas\": [\n      { \"numero\": 1, \"capacidadLitros\": 10000 },\n      { \"numero\": 2, \"capacidadLitros\": 5000 }\n    ]\n  },\n  \"chofer\": { \"codigoExterno\": \"CHO-001\", \"nombre\": \"Juan\", \"apellido\": \"Perez\", \"documento\": \"30123456\" },\n  \"cliente\": { \"codigoExterno\": \"CLI-001\", \"razonSocial\": \"Gas del Centro S.A.\", \"contacto\": \"compras@gasdelcentro.com\" },\n  \"producto\": { \"codigoExterno\": \"PRO-001\", \"nombre\": \"Propano\", \"descripcion\": \"Gas licuado de petroleo\" },\n  \"fechaPrevistaCarga\": \"2026-11-10T08:00:00\",\n  \"preset\": 20000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Numero de orden aleatorio para poder correr la coleccion muchas veces sin duplicados",
                  "pm.collectionVariables.set(\"numeroOrden\", Math.floor(100000 + Math.random() * 900000000));",
                  "pm.collectionVariables.set(\"masa\", 0);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 201\", () => pm.response.to.have.status(201));",
                  "",
                  "const o = pm.response.json();",
                  "pm.test(\"Queda en estado 1\", () => pm.expect(o.estadoNumero).to.eql(1));",
                  "pm.test(\"Capacidad total = suma de cisternas\", () => pm.expect(o.camion.capacidadTotalLitros).to.eql(15000));",
                  "pm.test(\"Header Location\", () => pm.response.to.have.header(\"Location\"));"
                ]
              }
            }
          ]
        },
