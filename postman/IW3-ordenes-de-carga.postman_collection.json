            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const c = pm.response.json();",
                  "const masa = Number(pm.collectionVariables.get(\"masa\"));",
                  "pm.test(\"Producto cargado = ultima masa\", () => pm.expect(c.productoCargado).to.eql(masa));",
                  "pm.test(\"Neto = final - tara\", () => pm.expect(c.netoPorBalanza).to.eql(c.pesajeFinal - c.pesajeInicial));",
                  "pm.test(\"Diferencia = neto - producto\", () => pm.expect(c.diferenciaBalanzaCaudalimetro).to.eql(c.netoPorBalanza - c.productoCargado));",
                  "pm.test(\"Promedios calculados\", () => pm.expect(c.promedioTemperatura).to.be.a(\"number\"));"
                ]
