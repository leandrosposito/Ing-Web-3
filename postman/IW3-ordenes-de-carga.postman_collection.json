                "ordenes",
                "{{numeroOrden}}",
                "detalle"
              ]
            },
            "description": "Punto 3.3. En el Runner se repite hasta masa = 5000 kg.",
            "body": {
              "mode": "raw",
              "raw": "{ \"masaAcumulada\": {{masa}}, \"densidad\": 0.52, \"temperatura\": {{temperatura}}, \"caudal\": 60000 }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const masa = Number(pm.collectionVariables.get(\"masa\") || 0) + 1000;",
                  "pm.collectionVariables.set(\"masa\", masa);",
                  "pm.collectionVariables.set(\"temperatura\", (15 + Math.random() * 10).toFixed(1));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "pm.test(\"Dato aceptado\", () => pm.expect(pm.response.json().aceptado).to.be.true);",
                  "// Simula el envio periodico: repite este request hasta llegar a 5000 kg (solo en el Collection Runner / newman)",
                  "if (Number(pm.collectionVariables.get(\"masa\")) < 5000) {",
                  "    pm.execution.setNextRequest(pm.info.requestName);",
                  "}"
                ]
              }
            }
          ]
        },
