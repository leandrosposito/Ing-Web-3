              "path": [
                "ordenes",
                "{{numeroOrden}}",
                "pesaje-inicial"
              ]
            },
            "description": "Punto 2. Devuelve la contrasena de activacion; se guarda en la variable {{password}}.",
            "body": {
              "mode": "raw",
              "raw": "{ \"pesaje\": 15000, \"observaciones\": \"Ingreso a planta\" }",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "",
                  "const r = pm.response.json();",
                  "pm.test(\"Pasa a estado 2\", () => pm.expect(r.estado).to.eql(\"CON_PESAJE_INICIAL\"));",
                  "pm.test(\"Password de 5 digitos\", () => pm.expect(String(r.password)).to.match(/^\\d{5}$/));",
                  "pm.collectionVariables.set(\"password\", r.password);",
                  "pm.collectionVariables.set(\"tara\", r.pesajeInicial);"
                ]
              }
            }
          ]
        },
